generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  idle
  charging
  driving
}

enum SiteType {
  depot
  home
  public
}

enum SessionStatus {
  active
  completed
}

enum ReimbursementStatus {
  pending
  approved
  paid
  rejected
}

enum UserRole {
  admin
  driver
}

model Vehicle {
  id                 String            @id @db.VarChar(32)
  name               String            @db.VarChar(64)
  batteryPercent     Int               @map("battery_percent") @db.UnsignedTinyInt
  chargeRateKw       Decimal           @default(0) @map("charge_rate_kw") @db.Decimal(5, 1)
  status             VehicleStatus     @default(idle)
  temperatureC       Int               @map("temperature_c") @db.TinyInt
  siteType           SiteType          @default(depot) @map("site_type")
  batteryCapacityKwh Decimal           @map("battery_capacity_kwh") @db.Decimal(6, 1)
  lat                Decimal           @db.Decimal(9, 5)
  lng                Decimal           @db.Decimal(9, 5)
  locationLabel      String            @map("location_label") @db.VarChar(128)
  postcode           String            @db.VarChar(16)
  gridRegion         String            @map("grid_region") @db.Char(1)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  sessions           ChargingSession[]
  drivers            Driver[]

  @@map("vehicles")
}

model Driver {
  id           String   @id @db.VarChar(32)
  name         String   @db.VarChar(64)
  email        String   @unique @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  vehicleId    String?  @map("vehicle_id") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("drivers")
}

model User {
  id             String            @id @default(cuid()) @db.VarChar(32)
  email          String            @unique @db.VarChar(255)
  passwordHash   String            @map("password_hash") @db.VarChar(255)
  name           String            @db.VarChar(128)
  role           UserRole          @default(driver)
  emailVerified  Boolean           @default(false) @map("email_verified")
  otpCodeHash    String?           @map("otp_code_hash") @db.VarChar(255)
  otpExpiresAt   DateTime?         @map("otp_expires_at") @db.Timestamp(0)
  resetCodeHash  String?           @map("reset_code_hash") @db.VarChar(255)
  resetExpiresAt DateTime?         @map("reset_expires_at") @db.Timestamp(0)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  sessions       ChargingSession[]

  @@map("users")
}

model ChargingSession {
  id               String          @id @db.VarChar(32)
  vehicleId        String          @map("vehicle_id") @db.VarChar(32)
  driverId         String          @map("driver_id") @db.VarChar(32)
  siteType         SiteType        @map("site_type")
  siteLabel        String?         @map("site_label") @db.VarChar(128)
  startedAt        DateTime        @map("started_at") @db.Timestamp(0)
  stoppedAt        DateTime?       @map("stopped_at") @db.Timestamp(0)
  kwh              Decimal?        @db.Decimal(8, 2)
  pricePencePerKwh Decimal?        @map("price_pence_per_kwh") @db.Decimal(8, 3)
  costGbp          Decimal?        @map("cost_gbp") @db.Decimal(10, 2)
  status           SessionStatus   @default(active)
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id])
  driver           User            @relation(fields: [driverId], references: [id])
  reimbursements   Reimbursement[]

  @@map("charging_sessions")
}

model Reimbursement {
  id        String              @id @db.VarChar(32)
  sessionId String              @map("session_id") @db.VarChar(32)
  driverId  String              @map("driver_id") @db.VarChar(32)
  amountGbp Decimal             @map("amount_gbp") @db.Decimal(10, 2)
  status    ReimbursementStatus @default(pending)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  // Snapshotted at claim time: a claim is a financial record, so it keeps the
  // plate/tariff it was filed under even if the vehicle or contract changes later.
  plate     String?             @db.VarChar(16)
  tariff    String?             @db.VarChar(64)
  source    String?             @db.VarChar(64)
  notes     String?             @db.Text
  session   ChargingSession     @relation(fields: [sessionId], references: [id])

  @@map("reimbursements")
}
