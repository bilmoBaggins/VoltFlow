PORT=3001

# MySQL (see docker-compose.yml — start with: docker compose up -d)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=voltflow
MYSQL_USER=voltflow
MYSQL_PASSWORD=voltflow

# Prisma (preferred connection string)
DATABASE_URL="mysql://voltflow:voltflow@127.0.0.1:3309/voltflow"

# Mailpit SMTP (dev — see docs/mailpitSetup.md)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=noreply@voltflow.local

# Auth
JWT_SECRET=dev-secret-change-me

# Where the web app is served — used for links inside emails
WEB_URL=http://localhost:5173

# Footer address printed in transactional emails
MAIL_COMPANY_ADDRESS="VoltFlow, Inc. · 214 Mission Street, San Francisco, CA 94105"
