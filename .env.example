# Copy to .env in the repo root (optional — defaults work for local demo)
MYSQL_ROOT_PASSWORD=voltflow_root
MYSQL_DATABASE=voltflow
MYSQL_USER=voltflow
MYSQL_PASSWORD=voltflow
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3309

# Prisma / API connection string
DATABASE_URL="mysql://voltflow:voltflow@127.0.0.1:3309/voltflow"

# Mailpit (local email UI + SMTP)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

